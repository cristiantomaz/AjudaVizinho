rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(resourceData) {
      return signedIn() && resourceData.ownerId == request.auth.uid;
    }

    match /users/{userId} {
      allow create, read, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /donations/{donationId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'available';
      allow update, delete: if owns(resource.data);
    }

    match /interests/{interestId} {
      allow create: if signedIn()
        && request.resource.data.interestedUserId == request.auth.uid;
      allow read: if signedIn()
        && (resource.data.interestedUserId == request.auth.uid
          || resource.data.ownerId == request.auth.uid);
      allow update: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow delete: if signedIn()
        && (resource.data.interestedUserId == request.auth.uid
          || resource.data.ownerId == request.auth.uid);
    }
  }
}
