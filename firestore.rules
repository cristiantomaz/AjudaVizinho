rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(resourceData) {
      return signedIn() && resourceData.ownerId == request.auth.uid;
    }

    function validDonationImage(data) {
      return !('imageData' in data)
        || data.imageData == ''
        || (data.imageData is string
          && data.imageData.size() <= 500000
          && data.imageData.matches('^data:image/(jpeg|png|webp);base64,.*$'));
    }

    match /users/{userId} {
      allow create, read, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /donations/{donationId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'available'
        && validDonationImage(request.resource.data);
      allow update: if owns(resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.status in ['available', 'reserved', 'donated']
        && validDonationImage(request.resource.data);
      allow delete: if owns(resource.data);
    }

    match /interests/{interestId} {
      allow create: if signedIn()
        && request.resource.data.interestedUserId == request.auth.uid
        && request.resource.data.ownerId != request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.ownerSeen == false
        && get(/databases/$(database)/documents/donations/$(request.resource.data.donationId)).data.ownerId == request.resource.data.ownerId
        && get(/databases/$(database)/documents/donations/$(request.resource.data.donationId)).data.status == 'available';
      allow read: if signedIn()
        && (resource.data.interestedUserId == request.auth.uid
          || resource.data.ownerId == request.auth.uid);
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'ownerSeen', 'updatedAt'])
        && request.resource.data.ownerSeen is bool
        && ((request.resource.data.status == resource.data.status
            && request.resource.data.ownerSeen == true)
          || request.resource.data.status in ['accepted', 'rejected']);
      allow delete: if signedIn()
        && (resource.data.interestedUserId == request.auth.uid
          || resource.data.ownerId == request.auth.uid);
    }

    match /messages/{messageId} {
      allow create: if signedIn()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.senderId in [
          request.resource.data.ownerId,
          request.resource.data.interestedUserId
        ]
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.seenByRecipient == false
        && get(/databases/$(database)/documents/interests/$(request.resource.data.interestId)).data.status == 'accepted'
        && get(/databases/$(database)/documents/interests/$(request.resource.data.interestId)).data.ownerId == request.resource.data.ownerId
        && get(/databases/$(database)/documents/interests/$(request.resource.data.interestId)).data.interestedUserId == request.resource.data.interestedUserId
        && get(/databases/$(database)/documents/interests/$(request.resource.data.interestId)).data.donationId == request.resource.data.donationId
        && get(/databases/$(database)/documents/donations/$(request.resource.data.donationId)).data.status == 'reserved';
      allow read: if signedIn()
        && request.auth.uid in [resource.data.ownerId, resource.data.interestedUserId];
      allow update: if signedIn()
        && request.auth.uid in [resource.data.ownerId, resource.data.interestedUserId]
        && request.auth.uid != resource.data.senderId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenByRecipient'])
        && request.resource.data.seenByRecipient == true;
      allow delete: if false;
    }
  }
}
